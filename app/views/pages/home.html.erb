<!-- Conteneur principal centré avec un espacement vertical -->
<div class="container my-5" style="max-width: 600px;">

  <!-- ========================================== -->
  <!-- 1. En-tête / Titre et description          -->
  <!-- ========================================== -->
  <div class="text-center mb-4">
    <!-- Icône ou emoji pop-corn / cinéma -->
    <div class="display-4 mb-2">🍿</div>

    <h1 class="h2 font-weight-bold">Quel film aimerais-tu regarder ?</h1>
    <p class="text-muted font-italic mb-1">Décris ton humeur et tes envies.</p>
    <p class="text-secondary small">Chaplin, notre assistant IA, t'aide à trouver le film idéal.</p>
  </div>

  <!-- ========================================== -->
  <!-- 2. Boutons d'action principaux             -->
  <!-- ========================================== -->
  <div class="d-flex flex-column gap-3 mb-5">
    <!-- Bouton pour démarrer une nouvelle recherche relié à /criterias/new -->
    <%= link_to "Nouvelle recherche", new_criteria_path, class: "btn btn-info text-white btn-lg shadow-sm w-100 rounded-pill py-2 font-weight-bold" %>

    <!-- Bouton pour voir l'historique relié à /conversations -->
    <%= link_to "Historique des recherches", conversations_path, class: "btn btn-warning text-white btn-lg shadow-sm w-100 rounded-pill py-2 font-weight-bold" %>
  </div>

  <!-- ========================================== -->
  <!-- 3. Section explicative : "Comment ça marche" -->
  <!-- ========================================== -->
  <div class="card p-4 border-0 shadow-sm rounded-4 bg-light">
    <h2 class="h4 text-center mb-4 font-weight-bold">Comment ça marche</h2>

    <div class="d-flex flex-column gap-3">

      <!-- Étape 1 -->
      <div class="text-center">
        <h3 class="h6 font-weight-bold mb-1">1. Renseigne ton profil</h3>
        <p class="text-muted small mb-0">Cinéphile ou amateur de blockbusters? Comédie ou drame?</p>
      </div>

      <!-- Étape 2 -->
      <div class="text-center">
        <h3 class="h6 font-weight-bold mb-1">2. Choisis tes critères pour la séance d'aujourd'hui</h3>
        <p class="text-muted small mb-0">Durée, audience, envies.</p>
      </div>

      <!-- Étape 3 -->
      <div class="text-center">
        <h3 class="h6 font-weight-bold mb-1">3. Discute avec l'IA</h3>
        <p class="text-muted small mb-0">Chaplin affine tes goûts.</p>
      </div>

      <!-- Étape 4 -->
      <div class="text-center">
        <h3 class="h6 font-weight-bold mb-1">4. Découvre ton film</h3>
        <p class="text-muted small mb-0">Une recommandation personnalisée.</p>
      </div>
    </div>
  </div>

</div>
