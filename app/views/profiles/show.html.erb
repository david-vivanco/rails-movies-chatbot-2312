<div class="container my-5" style="max-width: 680px;">
  <div class="card shadow-sm border-0 rounded-4 p-4 bg-light">
    <div class="text-center mb-4">
      <div class="display-3 mb-2"><%= current_user.avatar_url.presence || "🍿" %></div>
      <h2 class="fw-bold"><%= current_user.name.presence || "Mon profil cinéma" %></h2>
      <p class="text-muted"><%= current_user.email %></p>
    </div>

    <div class="mb-4 p-3 bg-white rounded-3 shadow-sm">
      <h5 class="fw-bold text-danger mb-2">🎭 Type de cinéphile</h5>
      <% if current_user.cinema_profile.present? %>
        <p class="mb-1 fw-bold"><%= current_user.cinema_profile %></p>
        <p class="text-muted small mb-0"><%= User::CINEMA_PROFILES[current_user.cinema_profile] %></p>
      <% else %>
        <p class="text-muted fst-italic mb-0">Non défini</p>
      <% end %>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="p-3 bg-white rounded-3 shadow-sm h-100">
          <h6 class="fw-bold text-success mb-2">💚 Genres favoris</h6>
          <% if current_user.favorite_genres.compact_blank.any? %>
            <div class="d-flex flex-wrap gap-1">
              <% current_user.favorite_genres.compact_blank.each do |genre| %>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill"><%= genre %></span>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted small fst-italic mb-0">Aucun genre favori sélectionné</p>
          <% end %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="p-3 bg-white rounded-3 shadow-sm h-100">
          <h6 class="fw-bold text-danger mb-2">🚫 Genres à éviter</h6>
          <% if current_user.disliked_genres.compact_blank.any? %>
            <div class="d-flex flex-wrap gap-1">
              <% current_user.disliked_genres.compact_blank.each do |genre| %>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill"><%= genre %></span>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted small fst-italic mb-0">Aucun genre à éviter sélectionné</p>
          <% end %>
        </div>
      </div>
    </div>

    <% if current_user.user_prompt.present? %>
      <div class="p-3 bg-white rounded-3 shadow-sm mb-4">
        <h6 class="fw-bold text-primary mb-1">🤖 Synthèse pour Chaplin</h6>
        <p class="small text-muted mb-0 fst-italic">"<%= current_user.user_prompt %>"</p>
      </div>
    <% end %>

    <div class="text-center">
      <%= link_to "Modifier mon profil", edit_profile_path, class: "btn btn-danger rounded-pill px-4 py-2 fw-bold" %>
    </div>
  </div>
</div>
