<div class="container my-5" style="max-width: 720px;">
  <div class="card shadow-sm border-0 rounded-4 p-4 bg-light">
    <div class="text-center mb-4">
      <span class="fs-1">🍿</span>
      <h2 class="fw-bold mt-2">Mon profil cinéma</h2>
      <p class="text-muted">Aide Chaplin à mieux comprendre tes goûts pour des recommandations sur-mesure.</p>
    </div>

    <%= simple_form_for(@user, url: profile_path, method: :patch) do |f| %>
      <%# Prénom / Nom %>
      <div class="mb-3">
        <%= f.input :name, label: "Ton prénom ou pseudo", input_html: { class: "rounded-pill", placeholder: "Ex: Jean" } %>
      </div>

      <%# Choix Avatar %>
      <div class="mb-4">
        <label class="form-label fw-bold">Choisis ton avatar</label>
        <div class="d-flex gap-2">
          <% User::AVATARS.each do |emoji| %>
            <%= f.radio_button :avatar_url,
                   emoji,
                   id: "avatar_#{emoji.ord}",
                   class: "avatar-radio" %>
              <label
                for="avatar_<%= emoji.ord %>"
                class="avatar-choice rounded-circle d-flex align-items-center justify-content-center">
                <%= emoji %>
              </label>
          <% end %>
        </div>
      </div>

      <%# Type de profil %>
      <div class="mb-4">
        <label class="form-label fw-bold">Quel type de cinéphile es-tu ?</label>
        <div class="d-flex flex-column gap-2">
          <% User::CINEMA_PROFILES.each do |title, desc| %>
            <label class="p-3 border rounded-3 bg-white d-flex align-items-start gap-3 cursor-pointer">
              <%= f.radio_button :cinema_profile, title, class: "form-check-input mt-1" %>
              <div>
                <strong><%= title %></strong>
                <p class="text-muted small mb-0"><%= desc %></p>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <%# Genres favoris %>
      <div class="mb-4">
        <label class="form-label fw-bold text-success">Genres préférés (jusqu'à 3)</label>
        <%= f.select :favorite_genres, User::GENRES, {}, { multiple: true, class: "form-select rounded-3", size: 6 } %>
        <div class="form-text">Maintiens Ctrl (Windows) ou Cmd (Mac) pour en sélectionner plusieurs.</div>
      </div>

      <%# Genres à éviter %>
      <div class="mb-4">
        <label class="form-label fw-bold text-danger">Genres à éviter / détestés (jusqu'à 3)</label>
        <%= f.select :disliked_genres, User::GENRES, {}, { multiple: true, class: "form-select rounded-3", size: 6 } %>
        <div class="form-text">Maintiens Ctrl (Windows) ou Cmd (Mac) pour en sélectionner plusieurs.</div>
      </div>

      <div class="d-grid gap-2 mt-4">
        <%= f.submit "Enregistrer mon profil", class: "btn btn-info text-white rounded-pill py-2 fw-bold shadow-sm" %>
        <%= link_to "Annuler", profile_path, class: "btn btn-link text-muted text-decoration-none text-center" %>
      </div>
    <% end %>
  </div>
</div>
