<!-- Conteneur centré reprenant la largeur et les marges de la page d'accueil -->
<div class="container my-5" style="max-width: 480px;">

  <!-- ========================================== -->
  <!-- 1. En-tête : Logo, Titre et Accroche       -->
  <!-- ========================================== -->
  <div class="text-center mb-4">
    <!-- Icône ou emoji pop-corn -->
    <div class="display-4 mb-2">🍿</div>
    <h1 class="h2 font-weight-bold">Movie Match</h1>
    <p class="text-muted font-italic mb-1">Trouve le film parfait grâce à l'IA !</p>
  </div>

  <!-- ========================================== -->
  <!-- 2. Carte formulaire                        -->
  <!-- ========================================== -->
  <div class="card p-4 border-0 shadow-sm rounded-4 bg-light">
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-inputs mb-3">
        <!-- Champ Email avec style arrondi -->
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    label: "Email",
                    input_html: {
                      autocomplete: "email",
                      class: "form-control rounded-pill px-3 py-2",
                      placeholder: "nom@exemple.com"
                    } %>

        <!-- Champ Mot de passe avec style arrondi -->
        <%= f.input :password,
                    required: false,
                    label: "Mot de passe",
                    input_html: {
                      autocomplete: "current-password",
                      class: "form-control rounded-pill px-3 py-2",
                      placeholder: "••••••••"
                    } %>

        <!-- Case à cocher "Se souvenir de moi" -->
        <%= f.input :remember_me, as: :boolean, label: "Se souvenir de moi" if devise_mapping.rememberable? %>
      </div>

      <!-- Bouton principal de connexion (style pilule bleu/cyan comme la maquette) -->
      <div class="form-actions mb-3">
        <%= f.button :submit, "Se connecter", class: "btn btn-info text-white btn-lg shadow-sm w-100 rounded-pill py-2 font-weight-bold" %>
      </div>
    <% end %>

    <!-- ========================================== -->
    <!-- 3. Liens Devise (Créer un compte, etc.)   -->
    <!-- ========================================== -->
    <div class="text-center mt-2 pt-3 border-top small">
      <%= render "devise/shared/links" %>
    </div>
  </div>

</div>
