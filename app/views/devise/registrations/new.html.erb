<!-- Conteneur centré reprenant la même largeur et le même espacement -->
<div class="container my-5" style="max-width: 480px;">

  <!-- ========================================== -->
  <!-- 1. En-tête : Logo, Titre et Accroche       -->
  <!-- ========================================== -->
  <div class="text-center mb-4">
    <div class="display-4 mb-2">🍿</div>
    <h1 class="h2 font-weight-bold">Movie Match</h1>
    <p class="text-muted font-italic mb-1">Rejoins l'aventure et trouve ton film idéal !</p>
  </div>

  <!-- ========================================== -->
  <!-- 2. Carte formulaire d'inscription         -->
  <!-- ========================================== -->
  <div class="card p-4 border-0 shadow-sm rounded-4 bg-light">
    <h2 class="h5 text-center mb-4 font-weight-bold">Créer un compte</h2>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= f.error_notification %>

      <div class="form-inputs mb-3">
        <!-- Champ Email -->
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    label: "Email",
                    input_html: {
                      autocomplete: "email",
                      class: "form-control rounded-pill px-3 py-2",
                      placeholder: "nom@exemple.com"
                    } %>

        <!-- Champ Mot de passe -->
        <%= f.input :password,
                    required: true,
                    label: "Mot de passe",
                    hint: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length),
                    hint_html: { class: "small text-muted mb-2 ms-2" },
                    input_html: {
                      autocomplete: "new-password",
                      class: "form-control rounded-pill px-3 py-2",
                      placeholder: "••••••••"
                    } %>

        <!-- Confirmation Mot de passe -->
        <%= f.input :password_confirmation,
                    required: true,
                    label: "Confirmer le mot de passe",
                    input_html: {
                      autocomplete: "new-password",
                      class: "form-control rounded-pill px-3 py-2",
                      placeholder: "••••••••"
                    } %>
      </div>

      <!-- Bouton d'action principal -->
      <div class="form-actions mb-3">
        <%= f.button :submit, "S'inscrire", class: "btn btn-info text-white btn-lg shadow-sm w-100 rounded-pill py-2 font-weight-bold" %>
      </div>
    <% end %>

    <!-- ========================================== -->
    <!-- 3. Liens de bas de carte (Connexion, etc.) -->
    <!-- ========================================== -->
    <div class="text-center mt-2 pt-3 border-top small">
      <%= render "devise/shared/links" %>
    </div>
  </div>

</div>
