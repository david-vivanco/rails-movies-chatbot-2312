<%# container principal %>
<div class="container my-5" style="max-width: 600px;">

<div class="d-flex flex-column gap-3 mb-5">
    <!-- Bouton pour démarrer une nouvelle recherche -->
    <!-- Remplace '#' par ton path Rails une fois la route prête, ex: new_criteria_path -->
    <%= link_to "Nouvelle recherche", new_criteria_path, class: "btn btn-info text-white btn-lg shadow-sm w-100 rounded-pill py-2" %>
    <%# <%= link_to "Retour à l'accueil", root_path, class: "btn btn-secondary text-white btn-sm shadow-sm w-50 py-1 mt-5" %>
</div>

  <h1 class="text-center fs-2">Mon historique de recherches</h1>

<%# container des conversations %>
<div class="container mt-4 mb-4">
  <% if @conversations.any?  %>
    <% @conversations.each do |conversation| %>
    <div class="conversation-item">
      <%= link_to conversation_path(conversation), class: "conversation-card" do %>
      <p class="fs-3"><span style="color: lightgrey;">·:·</span>🍿<span style="color: lightgrey;">·:·</span></p>
        <div class="conversation-card-content">
          <p><small><%= conversation.started_on %></small></p>
          <p><%= truncate(conversation.title, length: 80) %></p>
        </div>
      <% end %>
      <%# where is conversation.summary created? %>
      <div class="conversation-card-actions d-flex justify-content-end mb-3">
          <%= link_to conversation_path(conversation), method: :delete, data: { turbo_method: :delete, turbo_confirm: "Supprimer cette recherche ?" } do %>
            Supprimer <i class="far fa-trash-alt"></i>
          <% end %>
      </div>
    </div>
  <% end %>
  <% else %>
    <p>Aucune recherche pour l'instant 🍿</p>
  <% end %>
</div>

</div>
