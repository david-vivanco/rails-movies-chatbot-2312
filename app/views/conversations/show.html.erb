<div class="container my-5">
  <%# TITLE %>
  <div class="text-center mb-4">
    <h1>🍿 Assistant Cinéma 🍿</h1>
    <%# <div class="d-flex justify-content-center gap-3"> %>
        <%# <%= link_to @conversation.title, %>
            <%# conversation_path(@conversation), %>
            <%# data: { turbo_method: :delete }, %>
            <%# class: "btn btn-info text-white shadow-sm rounded-pill px-3 font-weight-bold" %>
        <%# %> 
    </div>
  </div>

  <div class="row gx-5">
    <%# LEFT SIDE for the chatbot %>
    <div id = "chat" class ="col-md-6 chat-container">
      <%# The exchanges "index" %>
      <div id="exchanges">
        <div class="my-4">
          <h5>🍿 Bonjour, je suis <strong>Chaplin</strong>, ton assistant cinéma</h5>
        </div>

        <div class = "row">
          <div class = "card-chaplin">
            <p>🍿:  Voici mes recommandations d'après tes critères pour ta séance d'aujourd'hui. Si tu ne trouves pas ton bonheur, discutons davantage pour affiner la recherche...</p>
          </div>

          <% @conversation.messages.each do |message|  %>
            <% if message.sender == "user" %>
              <div class="card-user">
                <p><strong> YOU : </strong><%= message.content %></p>
              </div>
            <% elsif message.sender == "AI" %>
              <div class = "card-chaplin">
                <p>🍿: <%= message.content %> </p>
              </div>
            <% end %>
          <% end %>
        </div>

      </div>

      <%# The form where the user writes its messages %>
      <div id = "new_message" class = "mt-3 border-top border-black border-3">
        <div id="chat_form" class="card-input mt-3 p-2" style="background:#f9f9f9; border-radius:10px;">
          <%= simple_form_for(@message, url: criteria_conversation_messages_path(@criteria, @conversation)) do |f| %>
            <div class="d-flex align-items-center">
              <%= f.text_field :content, class: 'form-control rounded-pill' , placeholder: 'Type your message...' %>
              <button type="submit" class="btn btn-flat ms-2" style="border-radius: 50%; width: 40px; height: 40px;">
                <i class="fa fa-paper-plane" aria-hidden="true"></i>
              </button>
            </div>
          <% end %>
        </div>
      </div>

    </div>

    <%# RIGHT SIDE for the recommendations %>

    <div class = "col-md-6">
      <div id="recommendation" class="pt-0">
          <div class="text-center my-4">
            <h5>🍿 Films recommandés par <strong>Chaplin</strong> 🍿</h5>
          </div>

        <div id = "instructions" class = "text-center my-4">
          <p>Si tu trouves ton bonheur, <strong>sélectionne</strong> le film pour mettre fin à la conversation. Sinon, continue à parler avec <strong>Chaplin</strong>.</p>
        </div>

        <%# remplace div class=cards pour permettre de selectionner un movie avec une modal%>
        <div class="cards" data-controller="movie-modal">

          <% @movies.each do |movie| %>
            <div class="card-movie">

              <div
                class="card-select m-1 text-center"
                data-action="click->movie-modal#open"
                data-title="<%= movie[:title] %>"
                data-poster="<%= movie[:poster_url] %>"
              >
                <h2>SELECT</h2>
              </div>

                <%= image_tag movie[:poster_url], alt: movie[:title] %>

              <div class="card-movie-infos">
                <div>
                  <h2>
                    <%= movie[:title] %>
                    <span class="fw-light"><%= movie[:rating] %></span>
                    <i class="fa-solid fa-star text-info fs-7"></i>
                  </h2>
                  <p><%= movie[:overview] %></p>
                </div>
              </div>

            </div>
          <% end %>

          <!-- MODALE -->

          <div
            data-movie-modal-target="modal"
            class="d-none position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
            style="background: rgba(0,0,0,.7); z-index: 9999;"
          >

            <div class="bg-white p-4 rounded text-center" style="max-width: 500px;">
              <h2 class="mb-3"><strong>Excellent choix !</strong></h2>

              <h3
                data-movie-modal-target="title"
                class="mb-3"
              ></h3>

              <img
                data-movie-modal-target="poster"
                src=""
                class="img-fluid rounded mb-4"
                style="max-height:300px;"
              > <%#vérifier la source de l'image%>

              <div class="d-flex justify-content-center gap-3">
                <%= link_to "Clore la conversation",
                  close_conversation_path(@conversation),
                  data: {
                    turbo_method: :patch,
                    movie_modal_target: "closeLink"
                  },
                  class: "btn btn-warning text-white shadow-sm w-100 rounded-pill px-3 font-weight-bold"
                %>

                <button
                  class="btn btn-info text-white shadow-sm w-100 rounded-pill px-3 font-weight-bold"
                  data-action="click->movie-modal#close"
                >
                  Revenir à la recherche
                </button>

              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
